{
    "name": "yii2-extensions/sentry",
    "description": "Yii2 logger for Sentry",
    "keywords": [
        "sentry",
        "yii2"
    ],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.4",
        "yiisoft/yii2": "^2.0.54",
        "sentry/sdk": "^4.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "codeception/codeception": "^5.3",
        "codeception/module-yii2": "^2.0",
        "codeception/module-asserts": "^3.3",
        "yiisoft/yii2-coding-standards": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "yii2\\extensions\\sentry\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "yii2\\extensions\\sentry\\tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "yiisoft/yii2-composer": true
        }
    }
}
